{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "barrier-tauri",
  "version": "3.0.0-alpha.1",
  "identifier": "org.barrier.tauri",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Barrier",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon_32x32.png",
      "icons/icon_128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Barrier - Share mouse and keyboard across computers",
    "longDescription": "Barrier is an open source software KVM (keyboard, video, mouses) switch that allows you to use one set of keyboard, mouse, and monitor to control multiple computers.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
